# Maintainer: Utkautka1 <https://github.com/Utkautka1>
pkgname=dimaster
pkgver=0.1.0
pkgrel=1
pkgdesc="GPU-accelerated Linux terminal emulator with Lua configuration and graphics protocols"
arch=('x86_64')
url="https://github.com/Utkautka1/DimaSter"
license=('MIT')
depends=(
  'fontconfig'
  'libxkbcommon'
  'wayland'
  'libx11'
  'libxcb'
  'vulkan-icd-loader'
)
makedepends=('cargo' 'rust')
optdepends=(
  'ffmpeg: video and extra image formats in icat / Kitty protocol'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "DimaSter-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "DimaSter-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p dimaster
}

check() {
  cd "DimaSter-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "DimaSter-$pkgver"
  install -Dm755 target/release/dimaster "$pkgdir/usr/bin/dimaster"
  install -Dm644 assets/dimaster.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dimaster.svg"
  install -Dm644 assets/dimaster.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/dimaster.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/dimaster.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=DimaSter
Comment=GPU-accelerated terminal emulator with Lua configuration
Exec=dimaster
Icon=dimaster
Categories=System;TerminalEmulator;
StartupWMClass=dimaster
EOF
}
