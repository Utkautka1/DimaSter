# Maintainer: Utkautka1 <https://github.com/Utkautka1>
pkgname=dimaster-bin
pkgver=0.4.1
pkgrel=1
pkgdesc="GPU-accelerated Linux terminal emulator with Lua configuration and graphics protocols (prebuilt binary)"
arch=('x86_64')
url="https://github.com/Utkautka1/DimaSter"
license=('MIT')
provides=('dimaster')
conflicts=('dimaster')
depends=(
  'fontconfig'
  'libxkbcommon'
  'wayland'
  'libx11'
  'libxcb'
  'vulkan-icd-loader'
)
optdepends=(
  'ffmpeg: video and extra image formats in icat / Kitty protocol'
)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/dimaster-linux-x86_64.tar.gz")
sha256sums=('e2adaf5d6de0ddbc52ba1ceb80b4d2a04a16c86a28c332b17000add83c6c7465')

package() {
  cd "dimaster-linux-x86_64"
  install -Dm755 dimaster "$pkgdir/usr/bin/dimaster"
  install -Dm644 dimaster.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dimaster.svg"
  install -Dm644 dimaster.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/dimaster.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/dimaster.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=DimaSter
Comment=GPU-accelerated terminal emulator with Lua configuration
Exec=dimaster
Icon=dimaster
Categories=System;TerminalEmulator;
StartupWMClass=dimaster
EOF
}
