# Интеграция DimaSter: ваш .bashrc читается как обычно, затем добавляются метки.
[ -f /etc/bash.bashrc ] && . /etc/bash.bashrc
[ -f ~/.bashrc ] && . ~/.bashrc

__dimaster_precmd() {
  local code=$?
  printf '\e]133;D;%s\a\e]7;file://%s%s\a\e]133;A\a' "$code" "$HOSTNAME" "${PWD//%/%25}"
  return $code
}
__dimaster_preexec() {
  local line
  line=$(HISTTIMEFORMAT= builtin history 1)
  line=${line#*[0-9]  }
  printf '\e]633;E;%s\a\e]133;C\a' "${line//[[:cntrl:]]/ }"
}
PROMPT_COMMAND="__dimaster_precmd${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
PS0='$(__dimaster_preexec)'"${PS0-}"

# «команда не найдена» на языке терминала, если своего обработчика нет
if [ -n "$DIMASTER_NOT_FOUND" ] && ! declare -F command_not_found_handle >/dev/null; then
  command_not_found_handle() {
    printf '%s: %s\n' "$1" "$DIMASTER_NOT_FOUND" >&2
    return 127
  }
fi
