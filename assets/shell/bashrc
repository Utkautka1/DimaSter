# Интеграция DimaSter: ваш .bashrc читается как обычно, затем добавляются метки.
[ -f /etc/bash.bashrc ] && . /etc/bash.bashrc
[ -f ~/.bashrc ] && . ~/.bashrc

if [ -n "${DIMASTER_STARTUP_FETCH-}" ]; then
  if [ -n "${DIMASTER_BIN-}" ] && [ -x "$DIMASTER_BIN" ]; then
    "$DIMASTER_BIN" fetch
  elif command -v dimaster >/dev/null 2>&1; then
    dimaster fetch
  fi
  unset DIMASTER_STARTUP_FETCH DIMASTER_BIN
fi

# алиасы из настроек терминала, поверх своих
if [ -n "${DIMASTER_ALIASES-}" ]; then
  eval "$DIMASTER_ALIASES"
  unset DIMASTER_ALIASES
fi

__dimaster_precmd() {
  local code=$?
  printf '\e]133;D;%s\a\e]7;file://%s%s\a\e]133;A\a' "$code" "$HOSTNAME" "${PWD//%/%25}"
  return $code
}
__dimaster_post_prompt() {
  case "${PS1-}" in
    *'133;B'*) ;;
    *) PS1="${PS1}\[\e]133;B\a\]" ;;
  esac
}
__dimaster_preexec() {
  local line
  line=$(HISTTIMEFORMAT= builtin history 1)
  line=${line#*[0-9]  }
  printf '\e]633;E;%s\a\e]133;C\a' "${line//[[:cntrl:]]/ }"
}
if [ -n "${DIMASTER_COLOR_LS-}" ]; then
  if ! alias ls >/dev/null 2>&1 && ! declare -F ls >/dev/null; then
    if command -v eza >/dev/null 2>&1; then
      alias ls='eza --icons=always --color=auto'
      alias ll >/dev/null 2>&1 || declare -F ll >/dev/null || alias ll='eza -al --icons=always --group-directories-first --color=auto'
    else
      alias ls='ls --color=auto'
      alias ll >/dev/null 2>&1 || declare -F ll >/dev/null || alias ll='ls -la --color=auto'
    fi
  fi
  alias grep >/dev/null 2>&1 || declare -F grep >/dev/null || alias grep='grep --color=auto'
  unset DIMASTER_COLOR_LS
fi
PROMPT_COMMAND="__dimaster_precmd${PROMPT_COMMAND:+;$PROMPT_COMMAND};__dimaster_post_prompt"
PS0='$(__dimaster_preexec)'"${PS0-}"

# «команда не найдена» на языке терминала, если своего обработчика нет
if [ -n "$DIMASTER_NOT_FOUND" ] && ! declare -F command_not_found_handle >/dev/null; then
  command_not_found_handle() {
    printf '%s: %s\n' "$1" "$DIMASTER_NOT_FOUND" >&2
    return 127
  }
fi

# подсветка nano, если своего nanorc, алиаса или функции нет
__dimaster_nanorc="${XDG_DATA_HOME:-$HOME/.local/share}/dimaster/shell/nanorc"
if [ -n "$DIMASTER_COLOR_NANO" ] && [ -r "$__dimaster_nanorc" ] && [ ! -e ~/.nanorc ] \
  && [ ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/nano/nanorc" ] && ! type -t nano | grep -qE 'alias|function'; then
  alias nano="nano --rcfile $(printf '%q' "$__dimaster_nanorc")"
fi
unset __dimaster_nanorc DIMASTER_COLOR_NANO
